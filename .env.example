# Pick ONE provider (or set several and choose per-run with --provider)
LLM_PROVIDER=gemini            # "gemini", "groq", or "grok"

# Gemini (Google AI Studio) - https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Gemini also serves as the universal automatic fallback when the active
# provider above (groq/grok/gemini itself) hits a rate limit that doesn't
# clear within its retry budget. These models are tried in order after the
# active provider's own model(s) are exhausted -- each one draws from a
# separate free-tier quota, so one being exhausted doesn't mean they all are.
# Requires GEMINI_API_KEY to be set.
GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-3.8-flash,gemini-3.7-flash,gemini-3.6-flash

# Groq (fast open-weight model hosting) - https://console.groq.com
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Grok (xAI) - https://console.x.ai -- NOT the same provider as Groq above
GROK_API_KEY=
GROK_MODEL=grok-4.6

# When LLM_PROVIDER=grok and grok-4.6 is rate-limited, these sibling Grok
# models are tried next (in order) before falling through to the Gemini
# fallback chain above.
GROK_FALLBACK_MODELS=grok-4.5,grok-4.3,grok-4.20-0309-non-reasoning

# Max output tokens for the lesson-generation call. Optional -- if unset, the
# app picks a sane default for whichever provider/model you configured above
# (see Settings._default_max_generation_tokens in lesson_agent/config.py).
# Set this to override that default.
#MAX_GENERATION_TOKENS=16384
